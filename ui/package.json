{
  "name": "stoker-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stoker control-plane web UI (Vite + React + TanStack Router/Query, built from Splunk's own component library).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "npm run build:smoke && node smoke.mjs",
    "build:smoke": "vite build --config vite.smoke.config.ts"
  },
  "dependencies": {
    "@splunk/react-icons": "^5.15.0",
    "@splunk/react-ui": "^5.16.0",
    "@splunk/themes": "^1.12.0",
    "@splunk/visualization-color-palettes": "^28.9.0",
    "@splunk/visualization-context": "^28.9.0",
    "@splunk/visualizations": "^28.9.0",
    "@tanstack/react-query": "^5.62.7",
    "@tanstack/react-router": "^1.95.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "styled-components": "^5.3.11"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "^1.95.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/styled-components": "^5.1.34",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^24.1.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
